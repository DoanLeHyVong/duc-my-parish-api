NODE_ENV=development
PORT=5000
DATABASE_URL="mysql://ducmy_user:CHANGE_ME@localhost:3306/ducmy"
# Required only while running the non-destructive consolidation tools.
PARISH_SOURCE_DATABASE_URL=
APPGLV_SOURCE_DATABASE_URL=
# Optional reviewed mapping file; leave unset to fail closed on identity collisions.
IDENTITY_MAPPING_FILE=
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SEED_ADMIN_USERNAME=
SEED_ADMIN_FULL_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Dedicated, transaction-safe rotation of the existing local Super Admin.
SUPER_ADMIN_SOURCE_USERNAME=
SUPER_ADMIN_TARGET_USERNAME=
SUPER_ADMIN_TARGET_EMAIL=
SUPER_ADMIN_PASSWORD=
LOG_LEVEL=info
