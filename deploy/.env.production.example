COMPOSE_PROJECT_NAME=ducmy-production
DEPLOY_ENVIRONMENT=production
API_IMAGE=ghcr.io/OWNER/duc-my-parish-api:production
WEB_IMAGE=ghcr.io/OWNER/duc-my-parish-web:production
DB_ENV_FILE=.env.production.db
API_ENV_FILE=.env.production.api
GHCR_USER=REPLACE_WITH_GITHUB_USERNAME
GHCR_TOKEN_FILE=/etc/ducmy/production/ghcr-token
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_IN_VPS_SECRET_FILE
PUBLIC_API_URL=https://api.hyvongofficial.online
PUBLIC_WEB_URL=https://giaoxu.hyvongofficial.online
RESTIC_REPOSITORY=REPLACE_WITH_OFF_VPS_REPOSITORY
RESTIC_PASSWORD_FILE=/etc/ducmy/production/restic-password
