COMPOSE_PROJECT_NAME=ducmy-staging
DEPLOY_ENVIRONMENT=staging
API_IMAGE=ghcr.io/OWNER/duc-my-parish-api:staging
WEB_IMAGE=ghcr.io/OWNER/duc-my-parish-web:staging
DB_ENV_FILE=.env.staging.db
API_ENV_FILE=.env.staging.api
GHCR_USER=REPLACE_WITH_GITHUB_USERNAME
GHCR_TOKEN_FILE=/etc/ducmy/staging/ghcr-token
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_IN_VPS_SECRET_FILE
PUBLIC_API_URL=https://api.hyvongofficial.online
PUBLIC_WEB_URL=https://giaoxu.hyvongofficial.online
