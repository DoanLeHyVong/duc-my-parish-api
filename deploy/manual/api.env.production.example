# Copy to /etc/ducmy/api.env and fill the empty secrets locally on the VPS.
# This file is read by both systemd EnvironmentFile and Bash api-release.sh.
# Keep each value on one line; do not use shell variable references or inline comments.
# DATABASE_URL format: mysql://ducmy_app:<URL_ENCODED_PASSWORD>@127.0.0.1:3306/ducmy_production
# Percent-encode reserved characters in the database password. Never commit the filled file.
NODE_ENV=production
PORT=5000
DATABASE_URL=
CLIENT_URL=https://giaoxu.hyvongofficial.online

# Supply two independently generated secrets of at least 24 characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Same-site HTTPS subdomains: leave COOKIE_DOMAIN unset for an API host-only cookie.
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Optional for API startup; all three are required for parish media upload/delete.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

LOG_LEVEL=info
# These apply to account-deletion requests; other API/auth limiters use code constants.
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
